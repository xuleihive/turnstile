# Core database. Use a dedicated PostgreSQL 16+ database and TLS in shared environments.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATA_BACKEND=postgresql

# Generate independent random values for every environment. Never commit real values.
CREDENTIAL_ENCRYPTION_KEY=
MANAGEMENT_API_KEY=

# Application behavior
PRODUCTION=false
CORS_ORIGINS=["http://localhost:5173"]
WEB_DIST_DIR=frontend/dist
MIGRATIONS_DIR=migrations
MODEL_COEFFICIENTS_JSON={"default":1.0}

# Microsoft Entra sign-in
ENTRA_CLIENT_ID=
ENTRA_ALLOWED_EMAIL_DOMAINS=["example.com"]
MEMBER_SESSION_TTL_HOURS=24
OWNER_SESSION_TTL_HOURS=12
SESSION_COOKIE_NAME=turnstile_session
DELEGATED_INVOCATION_TESTER_IDS=[]

# Initial deployment only. Generate the hash locally; never put a plaintext password here.
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_OWNER_PASSWORD_HASH=

# Azure API Management
AZURE_SUBSCRIPTION_ID=
APIM_RESOURCE_GROUP=
APIM_SERVICE_NAME=
APIM_PRINCIPAL_ID=
APIM_API_ID=turnstile-llm
APIM_GATEWAY_URL=
APIM_DASHBOARD_SUBSCRIPTION_ID=turnstile-dashboard
APIM_DASHBOARD_SUBSCRIPTION_KEY=
APIM_PROBE_SUBSCRIPTION_ID=turnstile-publisher-probe
APIM_PROBE_SUBSCRIPTION_KEY=
APIM_REGRESSION_MODEL_KEY=
GATEWAY_APPLICATION_KEY_MANAGEMENT_ENABLED=false
GATEWAY_APPLICATION_PROVISIONING_ENABLED=false

# Telemetry and budget ledger
LOG_ANALYTICS_WORKSPACE_ID=
LEDGER_SYNC_ENABLED=false
LEDGER_TABLE_ENDPOINT=
LEDGER_TABLE_NAME=TurnstileLedger
RECONCILIATION_ENABLED=true

# Optional publication worker. Keep disabled until APIM and the observer are configured.
CONTROL_PLANE_ENABLED=false
GATEWAY_PUBLICATION_WORKER_ENABLED=false
GATEWAY_RELEASE_WORKER_ENABLED=false
APIM_USAGE_OBSERVER_URL=
APIM_USAGE_OBSERVER_KEY_NAMED_VALUE=
