    "PriceSource": {
      "type": "string",
      "enum": [
        "manual",
        "models_dev",
        "azure_retail",
        "anthropic"
      ],
      "title": "PriceSource",
      "description": "Where a model's charged rates come from.\n\n`MANUAL` is what every model did before this existed: a person typed four numbers and they\nstay until that person changes them. The other two derive the rates as list price times\ndiscount and keep them current, which only works because the discount is stored separately\n-- a published list price is a fact, the discount is a contract term."
    },
